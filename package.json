{
  "name": "printcartridge-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manufacturer-independent printer and ink/toner cartridge database",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db": "tsx src/cli.ts",
    "collect:kyocera": "tsx src/collectors/kyocera.ts",
    "collect:epson": "tsx src/collectors/epson.ts",
    "collect:xerox": "tsx src/collectors/xerox.ts",
    "collect:hp": "tsx src/collectors/hp.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "fast-xml-parser": "^5.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": { "node": ">=22" }
}
